   0  $accept : programa $end

   1  programa : IDENTIFICADOR BEGIN cuerpo END
   2           | IDENTIFICADOR BEGIN END
   3           | IDENTIFICADOR BEGIN cuerpo
   4           | IDENTIFICADOR error cuerpo END
   5           | BEGIN cuerpo END
   6           | IDENTIFICADOR error cuerpo error

   7  cuerpo : cuerpo sentencia
   8         | sentencia

   9  sentencia : sentenciaDeclarativa
  10            | sentenciaEjecutable ';'
  11            | etiqueta
  12            | sentenciaEjecutable error
  13            | error ';'
  14            | sentenciaRet ';'

  15  sentenciaDeclarativa : tipoDato IDENTIFICADOR ';'
  16                       | tipoDato IDENTIFICADOR ',' listaVariable ';'
  17                       | tipoDato IDENTIFICADOR ',' error ';'
  18                       | tipoDato IDENTIFICADOR ',' listaVariable error ';'
  19                       | tipoDato IDENTIFICADOR error ';'
  20                       | typedefDeclaracion ';'
  21                       | typedefDeclaracion error
  22                       | tipoDato funDeclaracion ';'

  23  typedefDeclaracion : TYPEDEF declaracionSubtipo
  24                     | TYPEDEF declaracionTriple
  25                     | declaracionSubtipo
  26                     | error declaracionTriple
  27                     | TYPEDEF error

  28  declaracionSubtipo : IDENTIFICADOR SIMASIGNACION tipoDato '{' listaConstante '}'
  29                     | SIMASIGNACION tipoDato '{' listaConstante '}'
  30                     | IDENTIFICADOR SIMASIGNACION tipoDato '{' '}'

  31  declaracionTriple : TRIPLE '<' tipoDato '>' IDENTIFICADOR
  32                    | TRIPLE '<' IDENTIFICADOR '>' IDENTIFICADOR
  33                    | TRIPLE '<' error '>' IDENTIFICADOR
  34                    | TRIPLE '<' tipoDato '>' error
  35                    | TRIPLE '<' IDENTIFICADOR '>' error
  36                    | TRIPLE '<' error '>' error
  37                    | TRIPLE IDENTIFICADOR '>' IDENTIFICADOR
  38                    | TRIPLE '<' IDENTIFICADOR IDENTIFICADOR
  39                    | TRIPLE IDENTIFICADOR IDENTIFICADOR
  40                    | TRIPLE tipoDato IDENTIFICADOR

  41  funDeclaracion : funComienzo '(' parametro ')' BEGIN cuerpoFuncion END
  42                 | FUN error '(' parametro ')' BEGIN cuerpoFuncion END
  43                 | funComienzo '(' parametro ',' error ')' BEGIN cuerpoFuncion END
  44                 | funComienzo '(' parametro ')' BEGIN error END

  45  funComienzo : FUN IDENTIFICADOR

  46  tipoDato : SINGLE
  47           | LONGINT
  48           | HEXADECIMAL

  49  listaVariable : listaVariable ',' IDENTIFICADOR
  50                | listaVariable ',' error
  51                | IDENTIFICADOR

  52  listaConstante : listaConstante ',' constante
  53                 | constante

  54  constante : CONSTANTE
  55            | '-' CONSTANTE

  56  parametro : tipoDato IDENTIFICADOR
  57            | error IDENTIFICADOR
  58            | tipoDato error

  59  cuerpoFuncion : cuerpoFuncion sentenciaConRet
  60                | sentenciaConRet

  61  sentenciaConRet : sentenciaDeclarativa
  62                  | sentenciaEjecutableConRet ';'
  63                  | etiqueta
  64                  | sentenciaEjecutableConRet

  65  sentenciaRet : RET '(' expresion ')'

  66  sentenciaEjecutable : asignacion
  67                      | clausulaSeleccion
  68                      | clausulaBucle
  69                      | goto
  70                      | mensajeSalida

  71  sentenciaEjecutableConRet : asignacion
  72                            | clausulaBucle
  73                            | goto
  74                            | mensajeSalida
  75                            | sentenciaRet
  76                            | clausulaSeleccionConRet

  77  asignacion : IDENTIFICADOR SIMASIGNACION expresion
  78             | IDENTIFICADOR CADENA_MULTI SIMASIGNACION expresion
  79             | IDENTIFICADOR CONSTANTE SIMASIGNACION expresion

  80  expresion : expresion operador operando
  81            | expresion operador error
  82            | error operador operando
  83            | operando

  84  operador : '+'
  85           | '-'
  86           | '*'
  87           | '/'

  88  operando : IDENTIFICADOR
  89           | constante
  90           | invocacionFuncion
  91           | IDENTIFICADOR CADENA_MULTI
  92           | IDENTIFICADOR '1'
  93           | IDENTIFICADOR '2'
  94           | IDENTIFICADOR '3'

  95  invocacionFuncion : IDENTIFICADOR '(' expresion ')'
  96                    | IDENTIFICADOR '(' tipoDato expresion ')'
  97                    | IDENTIFICADOR '(' tipoDato '(' expresion ')' ')'
  98                    | IDENTIFICADOR '(' expresion ',' error ')'
  99                    | IDENTIFICADOR '(' error ')'
 100                    | IDENTIFICADOR '(' tipoDato expresion ',' error ')'
 101                    | IDENTIFICADOR '(' tipoDato '(' expresion ')' ',' error ')'

 102  clausulaSeleccion : IF '(' condicion ')' THEN bloqueSentenciaEjecutable END_IF
 103                    | IF '(' expresion ')' THEN bloqueSentenciaEjecutable END_IF
 104                    | IF '(' expresion ')' THEN bloqueSentenciaEjecutable ELSE bloqueSentenciaEjecutable END_IF
 105                    | IF '(' condicion ')' THEN bloqueSentenciaEjecutable ELSE bloqueSentenciaEjecutable END_IF
 106                    | IF '(' condicion ')' THEN bloqueSentenciaEjecutable error
 107                    | IF '(' condicion ')' THEN bloqueSentenciaEjecutable ELSE bloqueSentenciaEjecutable error
 108                    | IF '(' condicion THEN bloqueSentenciaEjecutable ELSE bloqueSentenciaEjecutable END_IF
 109                    | IF '(' condicion THEN bloqueSentenciaEjecutable END_IF
 110                    | IF condicion ')' THEN bloqueSentenciaEjecutable ELSE bloqueSentenciaEjecutable END_IF
 111                    | IF condicion ')' THEN bloqueSentenciaEjecutable END_IF
 112                    | IF condicion THEN bloqueSentenciaEjecutable ELSE bloqueSentenciaEjecutable END_IF
 113                    | IF condicion THEN bloqueSentenciaEjecutable END_IF
 114                    | IF '(' condicion ')' THEN error END_IF
 115                    | IF '(' condicion ')' THEN bloqueSentenciaEjecutable ELSE error END_IF
 116                    | IF '(' condicion ')' THEN error ELSE bloqueSentenciaEjecutable END_IF
 117                    | IF '(' condicion ')' THEN error ELSE error END_IF

 118  clausulaSeleccionConRet : IF '(' condicion ')' THEN bloqueSentenciaEjecutableConRet END_IF
 119                          | IF '(' expresion ')' THEN bloqueSentenciaEjecutableConRet END_IF
 120                          | IF '(' expresion ')' THEN bloqueSentenciaEjecutableConRet ELSE bloqueSentenciaEjecutableConRet END_IF
 121                          | IF '(' condicion ')' THEN bloqueSentenciaEjecutableConRet ELSE bloqueSentenciaEjecutableConRet END_IF
 122                          | IF '(' condicion ')' THEN bloqueSentenciaEjecutableConRet error
 123                          | IF '(' condicion ')' THEN bloqueSentenciaEjecutableConRet ELSE bloqueSentenciaEjecutableConRet error
 124                          | IF '(' condicion THEN bloqueSentenciaEjecutableConRet ELSE bloqueSentenciaEjecutableConRet END_IF
 125                          | IF '(' condicion THEN bloqueSentenciaEjecutableConRet END_IF
 126                          | IF condicion ')' THEN bloqueSentenciaEjecutableConRet ELSE bloqueSentenciaEjecutableConRet END_IF
 127                          | IF condicion ')' THEN bloqueSentenciaEjecutableConRet END_IF
 128                          | IF condicion THEN bloqueSentenciaEjecutableConRet ELSE bloqueSentenciaEjecutableConRet END_IF
 129                          | IF condicion THEN bloqueSentenciaEjecutableConRet END_IF
 130                          | IF '(' condicion ')' THEN error END_IF
 131                          | IF '(' condicion ')' THEN bloqueSentenciaEjecutableConRet ELSE error END_IF
 132                          | IF '(' condicion ')' THEN error ELSE bloqueSentenciaEjecutableConRet END_IF
 133                          | IF '(' condicion ')' THEN error ELSE error END_IF

 134  condicion : '(' expresion ',' listaExpresiones ')' comparador '(' expresion ',' listaExpresiones ')'
 135            | expresion ',' listaExpresiones comparador expresion ',' listaExpresiones
 136            | expresion ',' listaExpresiones comparador '(' expresion ',' listaExpresiones ')'
 137            | '(' expresion ',' listaExpresiones error comparador error expresion ',' listaExpresiones ')'
 138            | '(' expresion ',' listaExpresiones ')' comparador error expresion ',' listaExpresiones error
 139            | '(' expresion ',' listaExpresiones error comparador '(' expresion ',' listaExpresiones ')'
 140            | '(' expresion ',' listaExpresiones ')' comparador error expresion ',' listaExpresiones ')'
 141            | '(' expresion ',' listaExpresiones ')' error '(' expresion ',' listaExpresiones ')'
 142            | '(' expresion ',' listaExpresiones ')' comparador '(' expresion ',' listaExpresiones error
 143            | expresion comparador expresion
 144            | error comparador expresion
 145            | expresion comparador error
 146            | expresion error expresion

 147  listaExpresiones : listaExpresiones ',' expresion
 148                   | expresion
 149                   | listaExpresiones ',' error

 150  comparador : '<'
 151             | '>'
 152             | '='
 153             | DISTINTO
 154             | MENOR_IGUAL
 155             | MAYOR_IGUAL

 156  cuerpoEjecutable : cuerpoEjecutable sentenciaEjecutable ';'
 157                   | sentenciaEjecutable ';'
 158                   | sentenciaEjecutable error

 159  bloqueSentenciaEjecutable : sentenciaEjecutable ';'
 160                            | sentenciaEjecutable error
 161                            | BEGIN cuerpoEjecutable END

 162  cuerpoEjecutableConRet : cuerpoEjecutableConRet sentenciaEjecutableConRet ';'
 163                         | sentenciaEjecutableConRet ';'

 164  bloqueSentenciaEjecutableConRet : sentenciaEjecutableConRet ';'
 165                                  | sentenciaEjecutableConRet error
 166                                  | BEGIN cuerpoEjecutableConRet END

 167  clausulaBucle : REPEAT bloqueSentenciaEjecutable WHILE '(' condicion ')'
 168                | REPEAT error WHILE '(' condicion ')'
 169                | REPEAT bloqueSentenciaEjecutable WHILE error condicion ')'
 170                | REPEAT bloqueSentenciaEjecutable WHILE '(' error ')'
 171                | REPEAT bloqueSentenciaEjecutable WHILE '(' condicion
 172                | REPEAT bloqueSentenciaEjecutable WHILE error condicion error
 173                | REPEAT error WHILE '(' error ')'
 174                | REPEAT error WHILE error condicion error
 175                | REPEAT bloqueSentenciaEjecutable error

 176  goto : GOTO etiqueta '@'
 177       | GOTO etiqueta error
 178       | GOTO error '@'
 179       | etiqueta '@'

 180  etiqueta : IDENTIFICADOR ':'
 181           | ':'

 182  mensajeSalida : OUTF '(' expresion ')'
 183                | OUTF '(' CADENA_MULTI ')'
 184                | OUTF '(' error ')'

