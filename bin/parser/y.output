   0  $accept : programa $end

   1  programa : IDENTIFICADOR BEGIN cuerpo END
   2           | IDENTIFICADOR BEGIN END
   3           | IDENTIFICADOR BEGIN cuerpo
   4           | IDENTIFICADOR error cuerpo END
   5           | BEGIN cuerpo END
   6           | IDENTIFICADOR error cuerpo error

   7  cuerpo : cuerpo sentencia
   8         | sentencia

   9  sentencia : sentenciaDeclarativa
  10            | sentenciaEjecutable ';'
  11            | etiqueta
  12            | sentenciaEjecutable
  13            | error ';'

  14  sentenciaDeclarativa : tipoDato IDENTIFICADOR ';'
  15                       | tipoDato IDENTIFICADOR ',' listaVariable ';'
  16                       | tipoDato IDENTIFICADOR ',' ';'
  17                       | tipoDato IDENTIFICADOR ',' listaVariable error ';'
  18                       | tipoDato IDENTIFICADOR error ';'
  19                       | typedefDeclaracion ';'
  20                       | tipoDato funDeclaracion ';'

  21  typedefDeclaracion : TYPEDEF declaracionSubtipo
  22                     | TYPEDEF declaracionTriple
  23                     | declaracionSubtipo
  24                     | declaracionTriple
  25                     | TYPEDEF

  26  declaracionSubtipo : IDENTIFICADOR SIMASIGNACION tipoDato '{' listaConstante '}'
  27                     | SIMASIGNACION tipoDato '{' listaConstante '}'

  28  declaracionTriple : TRIPLE '<' tipoDato '>' IDENTIFICADOR
  29                    | TRIPLE '<' IDENTIFICADOR '>' IDENTIFICADOR
  30                    | TRIPLE '<' '>' IDENTIFICADOR
  31                    | TRIPLE '<' tipoDato '>'
  32                    | TRIPLE '<' IDENTIFICADOR '>'
  33                    | TRIPLE '<' '>'
  34                    | TRIPLE IDENTIFICADOR '>' IDENTIFICADOR
  35                    | TRIPLE '<' IDENTIFICADOR IDENTIFICADOR
  36                    | TRIPLE IDENTIFICADOR IDENTIFICADOR
  37                    | TRIPLE tipoDato IDENTIFICADOR

  38  funDeclaracion : FUN IDENTIFICADOR '(' parametro ')' BEGIN cuerpoFuncion END
  39                 | FUN '(' parametro ')' BEGIN cuerpoFuncion END
  40                 | FUN IDENTIFICADOR '(' parametro ',' ')' BEGIN cuerpoFuncion END
  41                 | FUN IDENTIFICADOR '(' parametro ')' BEGIN END

  42  tipoDato : SINGLE
  43           | LONGINT
  44           | HEXADECIMAL

  45  listaVariable : listaVariable ',' IDENTIFICADOR
  46                | listaVariable ','
  47                | IDENTIFICADOR

  48  listaConstante : listaConstante ',' constante
  49                 | constante

  50  constante : CONSTANTE
  51            | '-' CONSTANTE

  52  parametro : tipoDato IDENTIFICADOR
  53            | IDENTIFICADOR
  54            | tipoDato

  55  cuerpoFuncion : cuerpoFuncion sentenciaConRet
  56                | sentenciaConRet

  57  sentenciaConRet : sentenciaDeclarativa ';'
  58                  | sentenciaEjecutableConRet ';'
  59                  | etiqueta
  60                  | sentenciaDeclarativa
  61                  | sentenciaEjecutableConRet

  62  sentenciaRet : RET '(' expresion ')'

  63  sentenciaEjecutable : asignacion
  64                      | clausulaSeleccion
  65                      | clausulaBucle
  66                      | goto
  67                      | mensajeSalida

  68  sentenciaEjecutableConRet : asignacion
  69                            | clausulaBucle
  70                            | goto
  71                            | mensajeSalida
  72                            | sentenciaRet
  73                            | clausulaSeleccionConRet

  74  asignacion : IDENTIFICADOR SIMASIGNACION expresion
  75             | IDENTIFICADOR CADENA_MULTI SIMASIGNACION expresion

  76  expresion : expresion error operando
  77            | expresion '+' operando
  78            | error '+' operando
  79            | expresion '+' error
  80            | operando

  81  operando : IDENTIFICADOR
  82           | constante
  83           | invocacionFuncion
  84           | IDENTIFICADOR CADENA_MULTI
  85           | IDENTIFICADOR '1'
  86           | IDENTIFICADOR '2'
  87           | IDENTIFICADOR '3'

  88  invocacionFuncion : IDENTIFICADOR '(' expresion ')'
  89                    | IDENTIFICADOR '(' tipoDato expresion ')'
  90                    | IDENTIFICADOR '(' tipoDato '(' expresion ')' ')'
  91                    | IDENTIFICADOR '(' expresion ',' ')'
  92                    | IDENTIFICADOR '(' ')'
  93                    | IDENTIFICADOR '(' tipoDato expresion ',' ')'
  94                    | IDENTIFICADOR '(' tipoDato '(' expresion ')' ',' ')'

  95  clausulaSeleccion : IF '(' condicion ')' THEN bloqueSentenciaEjecutable END_IF
  96                    | IF '(' condicion ')' THEN bloqueSentenciaEjecutable ELSE bloqueSentenciaEjecutable END_IF
  97                    | IF '(' condicion ')' THEN bloqueSentenciaEjecutable
  98                    | IF '(' condicion ')' THEN bloqueSentenciaEjecutable ELSE bloqueSentenciaEjecutable
  99                    | IF '(' condicion THEN bloqueSentenciaEjecutable ELSE bloqueSentenciaEjecutable END_IF
 100                    | IF '(' condicion THEN bloqueSentenciaEjecutable END_IF
 101                    | IF condicion ')' THEN bloqueSentenciaEjecutable ELSE bloqueSentenciaEjecutable END_IF
 102                    | IF condicion ')' THEN bloqueSentenciaEjecutable END_IF
 103                    | IF condicion THEN bloqueSentenciaEjecutable ELSE bloqueSentenciaEjecutable END_IF
 104                    | IF condicion THEN bloqueSentenciaEjecutable END_IF
 105                    | IF '(' condicion ')' THEN END_IF
 106                    | IF '(' condicion ')' THEN bloqueSentenciaEjecutable ELSE END_IF
 107                    | IF '(' condicion ')' THEN ELSE bloqueSentenciaEjecutable END_IF
 108                    | IF '(' condicion ')' THEN ELSE END_IF

 109  clausulaSeleccionConRet : IF '(' condicion ')' THEN bloqueSentenciaEjecutableConRet END_IF
 110                          | IF '(' condicion ')' THEN bloqueSentenciaEjecutableConRet ELSE bloqueSentenciaEjecutableConRet END_IF
 111                          | IF '(' condicion ')' THEN bloqueSentenciaEjecutableConRet error
 112                          | IF '(' condicion ')' THEN bloqueSentenciaEjecutableConRet ELSE bloqueSentenciaEjecutableConRet error
 113                          | IF '(' condicion THEN bloqueSentenciaEjecutableConRet ELSE bloqueSentenciaEjecutableConRet END_IF
 114                          | IF '(' condicion THEN bloqueSentenciaEjecutableConRet END_IF
 115                          | IF condicion ')' THEN bloqueSentenciaEjecutableConRet ELSE bloqueSentenciaEjecutableConRet END_IF
 116                          | IF condicion ')' THEN bloqueSentenciaEjecutableConRet END_IF
 117                          | IF condicion THEN bloqueSentenciaEjecutableConRet ELSE bloqueSentenciaEjecutableConRet END_IF
 118                          | IF condicion THEN bloqueSentenciaEjecutableConRet END_IF
 119                          | IF '(' condicion ')' THEN END_IF
 120                          | IF '(' condicion ')' THEN bloqueSentenciaEjecutableConRet ELSE error END_IF
 121                          | IF '(' condicion ')' THEN ELSE bloqueSentenciaEjecutableConRet END_IF
 122                          | IF '(' condicion ')' THEN ELSE END_IF

 123  condicion : listaExpresiones comparador listaExpresiones
 124            | listaExpresiones comparador error
 125            | comparador listaExpresiones
 126            | listaExpresiones error listaExpresiones

 127  listaExpresiones : '(' listaExpresion ')'
 128                   | listaExpresion

 129  listaExpresion : listaExpresion ',' expresion
 130                 | expresion
 131                 | ',' expresion
 132                 | listaExpresion ',' error

 133  comparador : '<'
 134             | '>'
 135             | '='
 136             | DISTINTO
 137             | MENOR_IGUAL
 138             | MAYOR_IGUAL

 139  cuerpoEjecutable : cuerpoEjecutable sentenciaEjecutable ';'
 140                   | sentenciaEjecutable ';'
 141                   | sentenciaEjecutable

 142  bloqueSentenciaEjecutable : sentenciaEjecutable ';'
 143                            | sentenciaEjecutable error
 144                            | BEGIN cuerpoEjecutable END

 145  cuerpoEjecutableConRet : cuerpoEjecutableConRet sentenciaEjecutableConRet ';'
 146                         | sentenciaEjecutableConRet ';'

 147  bloqueSentenciaEjecutableConRet : sentenciaEjecutableConRet
 148                                  | BEGIN cuerpoEjecutableConRet END

 149  clausulaBucle : REPEAT bloqueSentenciaEjecutable WHILE '(' condicion ')'
 150                | REPEAT WHILE '(' condicion ')'
 151                | REPEAT bloqueSentenciaEjecutable WHILE condicion ')'
 152                | REPEAT bloqueSentenciaEjecutable WHILE '(' ')'
 153                | REPEAT bloqueSentenciaEjecutable WHILE '(' condicion
 154                | REPEAT bloqueSentenciaEjecutable WHILE condicion
 155                | REPEAT WHILE '(' ')'
 156                | REPEAT WHILE condicion
 157                | REPEAT bloqueSentenciaEjecutable

 158  goto : GOTO etiqueta '@'
 159       | GOTO etiqueta
 160       | etiqueta '@'

 161  etiqueta : IDENTIFICADOR ':'
 162           | error ':'

 163  mensajeSalida : OUTF '(' expresion ')'
 164                | OUTF '(' CADENA_MULTI ')'
 165                | OUTF '(' ')'

