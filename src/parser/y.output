   0  $accept : programa $end

   1  programa : IDENTIFICADOR BEGIN cuerpo END
   2           | IDENTIFICADOR BEGIN END
   3           | IDENTIFICADOR BEGIN cuerpo
   4           | IDENTIFICADOR error cuerpo END
   5           | BEGIN cuerpo END
   6           | IDENTIFICADOR error cuerpo error

   7  cuerpo : cuerpo sentencia
   8         | sentencia

   9  sentencia : sentenciaDeclarativa
  10            | sentenciaEjecutable ';'
  11            | etiqueta
  12            | sentenciaEjecutable error
  13            | error ';'
  14            | sentenciaRet ';'

  15  sentenciaDeclarativa : tipoDato IDENTIFICADOR ';'
  16                       | tipoDato IDENTIFICADOR ',' listaVariable ';'
  17                       | tipoDato IDENTIFICADOR ',' error ';'
  18                       | tipoDato IDENTIFICADOR ',' listaVariable error ';'
  19                       | tipoDato IDENTIFICADOR error ';'
  20                       | typedefDeclaracion ';'
  21                       | typedefDeclaracion error
  22                       | tipoDato funDeclaracion ';'
  23                       | funDeclaracion ';'

  24  typedefDeclaracion : TYPEDEF declaracionSubtipo
  25                     | TYPEDEF declaracionTriple
  26                     | declaracionSubtipo
  27                     | error declaracionTriple
  28                     | TYPEDEF error

  29  declaracionSubtipo : IDENTIFICADOR SIMASIGNACION tipoDato '{' listaConstante '}'
  30                     | SIMASIGNACION tipoDato '{' listaConstante '}'
  31                     | IDENTIFICADOR SIMASIGNACION tipoDato '{' '}'

  32  declaracionTriple : TRIPLE '<' tipoDato '>' IDENTIFICADOR
  33                    | TRIPLE '<' IDENTIFICADOR '>' IDENTIFICADOR
  34                    | TRIPLE '<' error '>' IDENTIFICADOR
  35                    | TRIPLE '<' tipoDato '>' error
  36                    | TRIPLE '<' IDENTIFICADOR '>' error
  37                    | TRIPLE '<' error '>' error
  38                    | TRIPLE IDENTIFICADOR '>' IDENTIFICADOR
  39                    | TRIPLE '<' IDENTIFICADOR IDENTIFICADOR
  40                    | TRIPLE IDENTIFICADOR IDENTIFICADOR
  41                    | TRIPLE tipoDato IDENTIFICADOR

  42  funDeclaracion : funComienzo '(' parametro ')' BEGIN cuerpoFuncion END
  43                 | FUN error '(' parametro ')' BEGIN cuerpoFuncion END
  44                 | funComienzo '(' parametro ',' error ')' BEGIN cuerpoFuncion END
  45                 | funComienzo '(' parametro ')' BEGIN error END

  46  funComienzo : FUN IDENTIFICADOR

  47  tipoDato : SINGLE
  48           | LONGINT
  49           | HEXADECIMAL

  50  listaVariable : listaVariable ',' IDENTIFICADOR
  51                | listaVariable ',' error
  52                | IDENTIFICADOR

  53  listaConstante : listaConstante ',' constante
  54                 | constante

  55  constante : CONSTANTE
  56            | '-' CONSTANTE

  57  parametro : tipoDato IDENTIFICADOR
  58            | error IDENTIFICADOR
  59            | tipoDato error

  60  cuerpoFuncion : cuerpoFuncion sentenciaConRet
  61                | sentenciaConRet

  62  sentenciaConRet : sentenciaDeclarativa
  63                  | sentenciaEjecutableConRet ';'
  64                  | etiqueta
  65                  | sentenciaEjecutableConRet

  66  sentenciaRet : RET '(' expresion ')'

  67  sentenciaEjecutable : asignacion
  68                      | clausulaSeleccion
  69                      | clausulaBucle
  70                      | goto
  71                      | mensajeSalida

  72  sentenciaEjecutableConRet : asignacion
  73                            | clausulaBucle
  74                            | goto
  75                            | mensajeSalida
  76                            | sentenciaRet
  77                            | clausulaSeleccionConRet

  78  asignacion : IDENTIFICADOR SIMASIGNACION expresion
  79             | IDENTIFICADOR CADENA_MULTI SIMASIGNACION expresion
  80             | IDENTIFICADOR CONSTANTE SIMASIGNACION expresion

  81  expresion : expresion operador operando
  82            | expresion operador error
  83            | error operador operando
  84            | operando

  85  operador : '+'
  86           | '-'
  87           | '*'
  88           | '/'

  89  operando : IDENTIFICADOR
  90           | constante
  91           | invocacionFuncion
  92           | IDENTIFICADOR CADENA_MULTI
  93           | IDENTIFICADOR '1'
  94           | IDENTIFICADOR '2'
  95           | IDENTIFICADOR '3'

  96  invocacionFuncion : IDENTIFICADOR '(' expresion ')'
  97                    | IDENTIFICADOR '(' tipoDato expresion ')'
  98                    | IDENTIFICADOR '(' tipoDato '(' expresion ')' ')'
  99                    | IDENTIFICADOR '(' expresion ',' error ')'
 100                    | IDENTIFICADOR '(' error ')'
 101                    | IDENTIFICADOR '(' tipoDato expresion ',' error ')'
 102                    | IDENTIFICADOR '(' tipoDato '(' expresion ')' ',' error ')'

 103  clausulaSeleccion : inicioClausulaSeleccion cuerpoThen END_IF
 104                    | IF '(' expresion ')' cuerpoThen END_IF
 105                    | IF '(' expresion ')' cuerpoThen ELSE bloqueSentenciaEjecutable END_IF
 106                    | inicioClausulaSeleccion cuerpoThen ELSE bloqueSentenciaEjecutable END_IF
 107                    | inicioClausulaSeleccion cuerpoThen error
 108                    | inicioClausulaSeleccion cuerpoThen ELSE bloqueSentenciaEjecutable error
 109                    | IF '(' condicion cuerpoThen ELSE bloqueSentenciaEjecutable END_IF
 110                    | IF '(' condicion cuerpoThen END_IF
 111                    | IF condicion ')' cuerpoThen ELSE bloqueSentenciaEjecutable END_IF
 112                    | IF condicion ')' cuerpoThen END_IF
 113                    | IF condicion cuerpoThen ELSE bloqueSentenciaEjecutable END_IF
 114                    | IF condicion cuerpoThen END_IF
 115                    | inicioClausulaSeleccion THEN error END_IF
 116                    | inicioClausulaSeleccion cuerpoThen ELSE error END_IF
 117                    | inicioClausulaSeleccion THEN error ELSE bloqueSentenciaEjecutable END_IF
 118                    | inicioClausulaSeleccion THEN error ELSE error END_IF

 119  inicioClausulaSeleccion : IF '(' condicion ')'

 120  cuerpoThen : THEN bloqueSentenciaEjecutable

 121  clausulaSeleccionConRet : IF '(' condicion ')' THEN bloqueSentenciaEjecutableConRet END_IF
 122                          | IF '(' expresion ')' THEN bloqueSentenciaEjecutableConRet END_IF
 123                          | IF '(' expresion ')' THEN bloqueSentenciaEjecutableConRet ELSE bloqueSentenciaEjecutableConRet END_IF
 124                          | IF '(' condicion ')' THEN bloqueSentenciaEjecutableConRet ELSE bloqueSentenciaEjecutableConRet END_IF
 125                          | IF '(' condicion ')' THEN bloqueSentenciaEjecutableConRet error
 126                          | IF '(' condicion ')' THEN bloqueSentenciaEjecutableConRet ELSE bloqueSentenciaEjecutableConRet error
 127                          | IF '(' condicion THEN bloqueSentenciaEjecutableConRet ELSE bloqueSentenciaEjecutableConRet END_IF
 128                          | IF '(' condicion THEN bloqueSentenciaEjecutableConRet END_IF
 129                          | IF condicion ')' THEN bloqueSentenciaEjecutableConRet ELSE bloqueSentenciaEjecutableConRet END_IF
 130                          | IF condicion ')' THEN bloqueSentenciaEjecutableConRet END_IF
 131                          | IF condicion THEN bloqueSentenciaEjecutableConRet ELSE bloqueSentenciaEjecutableConRet END_IF
 132                          | IF condicion THEN bloqueSentenciaEjecutableConRet END_IF
 133                          | IF '(' condicion ')' THEN error END_IF
 134                          | IF '(' condicion ')' THEN bloqueSentenciaEjecutableConRet ELSE error END_IF
 135                          | IF '(' condicion ')' THEN error ELSE bloqueSentenciaEjecutableConRet END_IF
 136                          | IF '(' condicion ')' THEN error ELSE error END_IF

 137  condicion : '(' expresion ',' listaExpresiones ')' comparador '(' expresion ',' listaExpresiones ')'
 138            | expresion ',' listaExpresiones comparador expresion ',' listaExpresiones
 139            | expresion ',' listaExpresiones comparador '(' expresion ',' listaExpresiones ')'
 140            | '(' expresion ',' listaExpresiones error comparador error expresion ',' listaExpresiones ')'
 141            | '(' expresion ',' listaExpresiones ')' comparador error expresion ',' listaExpresiones error
 142            | '(' expresion ',' listaExpresiones error comparador '(' expresion ',' listaExpresiones ')'
 143            | '(' expresion ',' listaExpresiones ')' comparador error expresion ',' listaExpresiones ')'
 144            | '(' expresion ',' listaExpresiones ')' error '(' expresion ',' listaExpresiones ')'
 145            | '(' expresion ',' listaExpresiones ')' comparador '(' expresion ',' listaExpresiones error
 146            | expresion comparador expresion
 147            | error comparador expresion
 148            | expresion comparador error
 149            | expresion error expresion

 150  listaExpresiones : listaExpresiones ',' expresion
 151                   | expresion
 152                   | listaExpresiones ',' error

 153  comparador : '<'
 154             | '>'
 155             | '='
 156             | DISTINTO
 157             | MENOR_IGUAL
 158             | MAYOR_IGUAL

 159  cuerpoEjecutable : cuerpoEjecutable sentenciaEjecutable ';'
 160                   | sentenciaEjecutable ';'
 161                   | sentenciaEjecutable error

 162  bloqueSentenciaEjecutable : sentenciaEjecutable ';'
 163                            | sentenciaEjecutable error
 164                            | BEGIN cuerpoEjecutable END

 165  cuerpoEjecutableConRet : cuerpoEjecutableConRet sentenciaEjecutableConRet ';'
 166                         | sentenciaEjecutableConRet ';'

 167  bloqueSentenciaEjecutableConRet : sentenciaEjecutableConRet ';'
 168                                  | sentenciaEjecutableConRet error
 169                                  | BEGIN cuerpoEjecutableConRet END

 170  clausulaBucle : repeat bloqueSentenciaEjecutable WHILE '(' condicion ')'
 171                | repeat error WHILE '(' condicion ')'
 172                | repeat bloqueSentenciaEjecutable WHILE error condicion ')'
 173                | repeat bloqueSentenciaEjecutable WHILE '(' error ')'
 174                | repeat bloqueSentenciaEjecutable WHILE '(' condicion
 175                | repeat bloqueSentenciaEjecutable WHILE error condicion error
 176                | repeat error WHILE '(' error ')'
 177                | repeat error WHILE error condicion error
 178                | repeat bloqueSentenciaEjecutable error

 179  repeat : REPEAT

 180  goto : GOTO IDENTIFICADOR '@'
 181       | GOTO IDENTIFICADOR error
 182       | GOTO error '@'
 183       | IDENTIFICADOR '@'

 184  etiqueta : IDENTIFICADOR ':'
 185           | ':'

 186  mensajeSalida : OUTF '(' expresion ')'
 187                | OUTF '(' CADENA_MULTI ')'
 188                | OUTF '(' error ')'

