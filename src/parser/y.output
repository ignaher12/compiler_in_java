   0  $accept : programa $end

   1  programa : IDENTIFICADOR BEGIN cuerpo END
   2           | IDENTIFICADOR BEGIN END
   3           | IDENTIFICADOR BEGIN cuerpo
   4           | IDENTIFICADOR error cuerpo END
   5           | BEGIN cuerpo END
   6           | IDENTIFICADOR error cuerpo error

   7  cuerpo : cuerpo sentencia
   8         | sentencia

   9  sentencia : sentenciaDeclarativa
  10            | sentenciaEjecutable ';'
  11            | etiqueta
  12            | sentenciaEjecutable error
  13            | error ';'
  14            | sentenciaRet ';'

  15  sentenciaDeclarativa : tipoDato IDENTIFICADOR ';'
  16                       | tipoDato IDENTIFICADOR ',' listaVariable ';'
  17                       | tipoDato IDENTIFICADOR ',' error ';'
  18                       | tipoDato IDENTIFICADOR ',' listaVariable error ';'
  19                       | tipoDato IDENTIFICADOR error ';'
  20                       | typedefDeclaracion ';'
  21                       | typedefDeclaracion error
  22                       | tipoDato funDeclaracion ';'
  23                       | funDeclaracion ';'

  24  typedefDeclaracion : TYPEDEF declaracionSubtipo
  25                     | TYPEDEF declaracionTriple
  26                     | declaracionSubtipo
  27                     | error declaracionTriple
  28                     | TYPEDEF error

  29  declaracionSubtipo : IDENTIFICADOR SIMASIGNACION tipoDato '{' listaConstante '}'
  30                     | SIMASIGNACION tipoDato '{' listaConstante '}'
  31                     | IDENTIFICADOR SIMASIGNACION tipoDato '{' '}'

  32  declaracionTriple : TRIPLE '<' tipoDato '>' IDENTIFICADOR
  33                    | TRIPLE '<' IDENTIFICADOR '>' IDENTIFICADOR
  34                    | TRIPLE '<' error '>' IDENTIFICADOR
  35                    | TRIPLE '<' tipoDato '>' error
  36                    | TRIPLE '<' IDENTIFICADOR '>' error
  37                    | TRIPLE '<' error '>' error
  38                    | TRIPLE IDENTIFICADOR '>' IDENTIFICADOR
  39                    | TRIPLE '<' IDENTIFICADOR IDENTIFICADOR
  40                    | TRIPLE IDENTIFICADOR IDENTIFICADOR
  41                    | TRIPLE tipoDato IDENTIFICADOR

  42  funDeclaracion : funComienzo '(' parametro ')' BEGIN cuerpoFuncion END
  43                 | FUN error '(' parametro ')' BEGIN cuerpoFuncion END
  44                 | funComienzo '(' parametro ',' error ')' BEGIN cuerpoFuncion END
  45                 | funComienzo '(' parametro ')' BEGIN error END

  46  funComienzo : FUN IDENTIFICADOR

  47  tipoDato : SINGLE
  48           | LONGINT
  49           | HEXADECIMAL

  50  listaVariable : listaVariable ',' IDENTIFICADOR
  51                | listaVariable ',' error
  52                | IDENTIFICADOR

  53  listaConstante : listaConstante ',' constante
  54                 | constante

  55  constante : CONSTANTE
  56            | '-' CONSTANTE

  57  parametro : tipoDato IDENTIFICADOR
  58            | error IDENTIFICADOR
  59            | tipoDato error

  60  cuerpoFuncion : cuerpoFuncion sentenciaConRet
  61                | sentenciaConRet

  62  sentenciaConRet : sentenciaDeclarativa
  63                  | sentenciaEjecutableConRet ';'
  64                  | etiqueta
  65                  | sentenciaEjecutableConRet

  66  sentenciaRet : RET '(' expresion ')'

  67  sentenciaEjecutable : asignacion
  68                      | clausulaSeleccion
  69                      | clausulaBucle
  70                      | goto
  71                      | mensajeSalida

  72  sentenciaEjecutableConRet : asignacion
  73                            | clausulaBucle
  74                            | goto
  75                            | mensajeSalida
  76                            | sentenciaRet
  77                            | clausulaSeleccionConRet

  78  asignacion : IDENTIFICADOR SIMASIGNACION expresion
  79             | IDENTIFICADOR CADENA_MULTI SIMASIGNACION expresion
  80             | IDENTIFICADOR CONSTANTE SIMASIGNACION expresion

  81  expresion : expresion '+' termino
  82            | expresion '+' error
  83            | error '+' termino
  84            | expresion '-' termino
  85            | expresion '-' error
  86            | error '-' termino
  87            | termino

  88  termino : termino '*' operando
  89          | termino '*' error
  90          | error '*' operando
  91          | termino '/' operando
  92          | termino '/' error
  93          | error '/' operando
  94          | operando

  95  operando : IDENTIFICADOR
  96           | constante
  97           | invocacionFuncion
  98           | IDENTIFICADOR CADENA_MULTI
  99           | IDENTIFICADOR '1'
 100           | IDENTIFICADOR '2'
 101           | IDENTIFICADOR '3'

 102  invocacionFuncion : IDENTIFICADOR '(' expresion ')'
 103                    | IDENTIFICADOR '(' tipoDato expresion ')'
 104                    | IDENTIFICADOR '(' tipoDato '(' expresion ')' ')'
 105                    | IDENTIFICADOR '(' expresion ',' error ')'
 106                    | IDENTIFICADOR '(' error ')'
 107                    | IDENTIFICADOR '(' tipoDato expresion ',' error ')'
 108                    | IDENTIFICADOR '(' tipoDato '(' expresion ')' ',' error ')'

 109  clausulaSeleccion : inicioClausulaSeleccion cuerpoThen END_IF
 110                    | IF '(' expresion ')' cuerpoThen END_IF
 111                    | IF '(' expresion ')' cuerpoThen ELSE bloqueSentenciaEjecutable END_IF
 112                    | inicioClausulaSeleccion cuerpoThen ELSE bloqueSentenciaEjecutable END_IF
 113                    | inicioClausulaSeleccion cuerpoThen error
 114                    | inicioClausulaSeleccion cuerpoThen ELSE bloqueSentenciaEjecutable error
 115                    | IF '(' condicion cuerpoThen ELSE bloqueSentenciaEjecutable END_IF
 116                    | IF '(' condicion cuerpoThen END_IF
 117                    | IF condicion ')' cuerpoThen ELSE bloqueSentenciaEjecutable END_IF
 118                    | IF condicion ')' cuerpoThen END_IF
 119                    | IF condicion cuerpoThen ELSE bloqueSentenciaEjecutable END_IF
 120                    | IF condicion cuerpoThen END_IF
 121                    | inicioClausulaSeleccion THEN error END_IF
 122                    | inicioClausulaSeleccion cuerpoThen ELSE error END_IF
 123                    | inicioClausulaSeleccion THEN error ELSE bloqueSentenciaEjecutable END_IF
 124                    | inicioClausulaSeleccion THEN error ELSE error END_IF

 125  inicioClausulaSeleccion : IF '(' condicion ')'

 126  cuerpoThen : THEN bloqueSentenciaEjecutable

 127  clausulaSeleccionConRet : inicioClausulaSeleccion cuerpoThenConRet END_IF
 128                          | IF '(' expresion ')' cuerpoThenConRet END_IF
 129                          | IF '(' expresion ')' cuerpoThenConRet ELSE bloqueSentenciaEjecutableConRet END_IF
 130                          | inicioClausulaSeleccion cuerpoThenConRet ELSE bloqueSentenciaEjecutableConRet END_IF
 131                          | inicioClausulaSeleccion cuerpoThenConRet error
 132                          | inicioClausulaSeleccion cuerpoThenConRet ELSE bloqueSentenciaEjecutableConRet error
 133                          | IF '(' condicion cuerpoThenConRet ELSE bloqueSentenciaEjecutableConRet END_IF
 134                          | IF '(' condicion cuerpoThenConRet END_IF
 135                          | IF condicion ')' cuerpoThenConRet ELSE bloqueSentenciaEjecutableConRet END_IF
 136                          | IF condicion ')' cuerpoThenConRet END_IF
 137                          | IF condicion cuerpoThenConRet ELSE bloqueSentenciaEjecutableConRet END_IF
 138                          | IF condicion cuerpoThenConRet END_IF
 139                          | inicioClausulaSeleccion THEN error END_IF
 140                          | inicioClausulaSeleccion cuerpoThenConRet ELSE error END_IF
 141                          | inicioClausulaSeleccion THEN error ELSE bloqueSentenciaEjecutableConRet END_IF
 142                          | inicioClausulaSeleccion THEN error ELSE error END_IF

 143  cuerpoThenConRet : THEN bloqueSentenciaEjecutableConRet

 144  condicion : '(' expresion ',' listaExpresiones ')' comparador '(' expresion ',' listaExpresiones ')'
 145            | expresion ',' listaExpresiones comparador expresion ',' listaExpresiones
 146            | expresion ',' listaExpresiones comparador '(' expresion ',' listaExpresiones ')'
 147            | '(' expresion ',' listaExpresiones error comparador error expresion ',' listaExpresiones ')'
 148            | '(' expresion ',' listaExpresiones ')' comparador error expresion ',' listaExpresiones error
 149            | '(' expresion ',' listaExpresiones error comparador '(' expresion ',' listaExpresiones ')'
 150            | '(' expresion ',' listaExpresiones ')' comparador error expresion ',' listaExpresiones ')'
 151            | '(' expresion ',' listaExpresiones ')' error '(' expresion ',' listaExpresiones ')'
 152            | '(' expresion ',' listaExpresiones ')' comparador '(' expresion ',' listaExpresiones error
 153            | expresion comparador expresion
 154            | error comparador expresion
 155            | expresion comparador error
 156            | expresion error expresion

 157  listaExpresiones : listaExpresiones ',' expresion
 158                   | expresion
 159                   | listaExpresiones ',' error

 160  comparador : '<'
 161             | '>'
 162             | '='
 163             | DISTINTO
 164             | MENOR_IGUAL
 165             | MAYOR_IGUAL

 166  cuerpoEjecutable : cuerpoEjecutable sentenciaEjecutable ';'
 167                   | sentenciaEjecutable ';'
 168                   | sentenciaEjecutable error

 169  bloqueSentenciaEjecutable : sentenciaEjecutable ';'
 170                            | sentenciaEjecutable error
 171                            | BEGIN cuerpoEjecutable END

 172  cuerpoEjecutableConRet : cuerpoEjecutableConRet sentenciaEjecutableConRet ';'
 173                         | sentenciaEjecutableConRet ';'

 174  bloqueSentenciaEjecutableConRet : sentenciaEjecutableConRet ';'
 175                                  | sentenciaEjecutableConRet error
 176                                  | BEGIN cuerpoEjecutableConRet END

 177  clausulaBucle : repeat bloqueSentenciaEjecutable WHILE '(' condicion ')'
 178                | repeat error WHILE '(' condicion ')'
 179                | repeat bloqueSentenciaEjecutable WHILE error condicion ')'
 180                | repeat bloqueSentenciaEjecutable WHILE '(' error ')'
 181                | repeat bloqueSentenciaEjecutable WHILE '(' condicion
 182                | repeat bloqueSentenciaEjecutable WHILE error condicion error
 183                | repeat error WHILE '(' error ')'
 184                | repeat error WHILE error condicion error
 185                | repeat bloqueSentenciaEjecutable error

 186  repeat : REPEAT

 187  goto : GOTO IDENTIFICADOR '@'
 188       | GOTO IDENTIFICADOR error
 189       | GOTO error '@'
 190       | IDENTIFICADOR '@'

 191  etiqueta : IDENTIFICADOR ':'
 192           | ':'

 193  mensajeSalida : OUTF '(' expresion ')'
 194                | OUTF '(' CADENA_MULTI ')'
 195                | OUTF '(' error ')'

