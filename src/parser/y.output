   0  $accept : programa $end

   1  programa : IDENTIFICADOR BEGIN cuerpo END
   2           | IDENTIFICADOR BEGIN END
   3           | IDENTIFICADOR BEGIN cuerpo
   4           | IDENTIFICADOR error cuerpo END
   5           | BEGIN cuerpo END
   6           | IDENTIFICADOR error cuerpo error

   7  cuerpo : cuerpo sentencia
   8         | sentencia

   9  sentencia : sentenciaDeclarativa
  10            | sentenciaEjecutable ';'
  11            | etiqueta
  12            | sentenciaEjecutable error
  13            | error ';'
  14            | sentenciaRet ';'

  15  sentenciaDeclarativa : tipoDato IDENTIFICADOR ';'
  16                       | tipoDato IDENTIFICADOR ',' listaVariable ';'
  17                       | tipoDato IDENTIFICADOR ',' error ';'
  18                       | tipoDato IDENTIFICADOR ',' listaVariable error ';'
  19                       | tipoDato IDENTIFICADOR error ';'
  20                       | typedefDeclaracion ';'
  21                       | typedefDeclaracion error
  22                       | tipoDato funDeclaracion ';'

  23  typedefDeclaracion : TYPEDEF declaracionSubtipo
  24                     | TYPEDEF declaracionTriple
  25                     | declaracionSubtipo
  26                     | error declaracionTriple
  27                     | TYPEDEF error

  28  declaracionSubtipo : IDENTIFICADOR SIMASIGNACION tipoDato '{' listaConstante '}'
  29                     | SIMASIGNACION tipoDato '{' listaConstante '}'
  30                     | IDENTIFICADOR SIMASIGNACION tipoDato '{' '}'

  31  declaracionTriple : TRIPLE '<' tipoDato '>' IDENTIFICADOR
  32                    | TRIPLE '<' IDENTIFICADOR '>' IDENTIFICADOR
  33                    | TRIPLE '<' error '>' IDENTIFICADOR
  34                    | TRIPLE '<' tipoDato '>' error
  35                    | TRIPLE '<' IDENTIFICADOR '>' error
  36                    | TRIPLE '<' error '>' error
  37                    | TRIPLE IDENTIFICADOR '>' IDENTIFICADOR
  38                    | TRIPLE '<' IDENTIFICADOR IDENTIFICADOR
  39                    | TRIPLE IDENTIFICADOR IDENTIFICADOR
  40                    | TRIPLE tipoDato IDENTIFICADOR

  41  funDeclaracion : FUN IDENTIFICADOR '(' parametro ')' BEGIN cuerpoFuncion END
  42                 | FUN error '(' parametro ')' BEGIN cuerpoFuncion END
  43                 | FUN IDENTIFICADOR '(' parametro ',' error ')' BEGIN cuerpoFuncion END
  44                 | FUN IDENTIFICADOR '(' parametro ')' BEGIN error END

  45  tipoDato : SINGLE
  46           | LONGINT
  47           | HEXADECIMAL

  48  listaVariable : listaVariable ',' IDENTIFICADOR
  49                | listaVariable ',' error
  50                | IDENTIFICADOR

  51  listaConstante : listaConstante ',' constante
  52                 | constante

  53  constante : CONSTANTE
  54            | '-' CONSTANTE

  55  parametro : tipoDato IDENTIFICADOR
  56            | error IDENTIFICADOR
  57            | tipoDato error

  58  cuerpoFuncion : cuerpoFuncion sentenciaConRet
  59                | sentenciaConRet

  60  sentenciaConRet : sentenciaDeclarativa
  61                  | sentenciaEjecutableConRet ';'
  62                  | etiqueta
  63                  | sentenciaEjecutableConRet

  64  sentenciaRet : RET '(' expresion ')'

  65  sentenciaEjecutable : asignacion
  66                      | clausulaSeleccion
  67                      | clausulaBucle
  68                      | goto
  69                      | mensajeSalida

  70  sentenciaEjecutableConRet : asignacion
  71                            | clausulaBucle
  72                            | goto
  73                            | mensajeSalida
  74                            | sentenciaRet
  75                            | clausulaSeleccionConRet

  76  asignacion : IDENTIFICADOR SIMASIGNACION expresion
  77             | IDENTIFICADOR CADENA_MULTI SIMASIGNACION expresion
  78             | IDENTIFICADOR CONSTANTE SIMASIGNACION expresion

  79  expresion : expresion operador operando
  80            | expresion operador error
  81            | error operador operando
  82            | operando

  83  operador : '+'
  84           | '-'
  85           | '*'
  86           | '/'

  87  operando : IDENTIFICADOR
  88           | constante
  89           | invocacionFuncion
  90           | IDENTIFICADOR CADENA_MULTI
  91           | IDENTIFICADOR '1'
  92           | IDENTIFICADOR '2'
  93           | IDENTIFICADOR '3'

  94  invocacionFuncion : IDENTIFICADOR '(' expresion ')'
  95                    | IDENTIFICADOR '(' tipoDato expresion ')'
  96                    | IDENTIFICADOR '(' tipoDato '(' expresion ')' ')'
  97                    | IDENTIFICADOR '(' expresion ',' error ')'
  98                    | IDENTIFICADOR '(' error ')'
  99                    | IDENTIFICADOR '(' tipoDato expresion ',' error ')'
 100                    | IDENTIFICADOR '(' tipoDato '(' expresion ')' ',' error ')'

 101  clausulaSeleccion : IF '(' condicion ')' THEN bloqueSentenciaEjecutable END_IF
 102                    | IF '(' expresion ')' THEN bloqueSentenciaEjecutable END_IF
 103                    | IF '(' expresion ')' THEN bloqueSentenciaEjecutable ELSE bloqueSentenciaEjecutable END_IF
 104                    | IF '(' condicion ')' THEN bloqueSentenciaEjecutable ELSE bloqueSentenciaEjecutable END_IF
 105                    | IF '(' condicion ')' THEN bloqueSentenciaEjecutable error
 106                    | IF '(' condicion ')' THEN bloqueSentenciaEjecutable ELSE bloqueSentenciaEjecutable error
 107                    | IF '(' condicion THEN bloqueSentenciaEjecutable ELSE bloqueSentenciaEjecutable END_IF
 108                    | IF '(' condicion THEN bloqueSentenciaEjecutable END_IF
 109                    | IF condicion ')' THEN bloqueSentenciaEjecutable ELSE bloqueSentenciaEjecutable END_IF
 110                    | IF condicion ')' THEN bloqueSentenciaEjecutable END_IF
 111                    | IF condicion THEN bloqueSentenciaEjecutable ELSE bloqueSentenciaEjecutable END_IF
 112                    | IF condicion THEN bloqueSentenciaEjecutable END_IF
 113                    | IF '(' condicion ')' THEN error END_IF
 114                    | IF '(' condicion ')' THEN bloqueSentenciaEjecutable ELSE error END_IF
 115                    | IF '(' condicion ')' THEN error ELSE bloqueSentenciaEjecutable END_IF
 116                    | IF '(' condicion ')' THEN error ELSE error END_IF

 117  clausulaSeleccionConRet : IF '(' condicion ')' THEN bloqueSentenciaEjecutableConRet END_IF
 118                          | IF '(' expresion ')' THEN bloqueSentenciaEjecutableConRet END_IF
 119                          | IF '(' expresion ')' THEN bloqueSentenciaEjecutableConRet ELSE bloqueSentenciaEjecutableConRet END_IF
 120                          | IF '(' condicion ')' THEN bloqueSentenciaEjecutableConRet ELSE bloqueSentenciaEjecutableConRet END_IF
 121                          | IF '(' condicion ')' THEN bloqueSentenciaEjecutableConRet error
 122                          | IF '(' condicion ')' THEN bloqueSentenciaEjecutableConRet ELSE bloqueSentenciaEjecutableConRet error
 123                          | IF '(' condicion THEN bloqueSentenciaEjecutableConRet ELSE bloqueSentenciaEjecutableConRet END_IF
 124                          | IF '(' condicion THEN bloqueSentenciaEjecutableConRet END_IF
 125                          | IF condicion ')' THEN bloqueSentenciaEjecutableConRet ELSE bloqueSentenciaEjecutableConRet END_IF
 126                          | IF condicion ')' THEN bloqueSentenciaEjecutableConRet END_IF
 127                          | IF condicion THEN bloqueSentenciaEjecutableConRet ELSE bloqueSentenciaEjecutableConRet END_IF
 128                          | IF condicion THEN bloqueSentenciaEjecutableConRet END_IF
 129                          | IF '(' condicion ')' THEN error END_IF
 130                          | IF '(' condicion ')' THEN bloqueSentenciaEjecutableConRet ELSE error END_IF
 131                          | IF '(' condicion ')' THEN error ELSE bloqueSentenciaEjecutableConRet END_IF
 132                          | IF '(' condicion ')' THEN error ELSE error END_IF

 133  condicion : '(' expresion ',' listaExpresiones ')' comparador '(' expresion ',' listaExpresiones ')'
 134            | expresion ',' listaExpresiones comparador expresion ',' listaExpresiones
 135            | expresion ',' listaExpresiones comparador '(' expresion ',' listaExpresiones ')'
 136            | '(' expresion ',' listaExpresiones error comparador error expresion ',' listaExpresiones ')'
 137            | '(' expresion ',' listaExpresiones ')' comparador error expresion ',' listaExpresiones error
 138            | '(' expresion ',' listaExpresiones error comparador '(' expresion ',' listaExpresiones ')'
 139            | '(' expresion ',' listaExpresiones ')' comparador error expresion ',' listaExpresiones ')'
 140            | '(' expresion ',' listaExpresiones ')' error '(' expresion ',' listaExpresiones ')'
 141            | '(' expresion ',' listaExpresiones ')' comparador '(' expresion ',' listaExpresiones error
 142            | expresion comparador expresion
 143            | error comparador expresion
 144            | expresion comparador error
 145            | expresion error expresion

 146  listaExpresiones : listaExpresiones ',' expresion
 147                   | expresion
 148                   | listaExpresiones ',' error

 149  comparador : '<'
 150             | '>'
 151             | '='
 152             | DISTINTO
 153             | MENOR_IGUAL
 154             | MAYOR_IGUAL

 155  cuerpoEjecutable : cuerpoEjecutable sentenciaEjecutable ';'
 156                   | sentenciaEjecutable ';'
 157                   | sentenciaEjecutable error

 158  bloqueSentenciaEjecutable : sentenciaEjecutable ';'
 159                            | sentenciaEjecutable error
 160                            | BEGIN cuerpoEjecutable END

 161  cuerpoEjecutableConRet : cuerpoEjecutableConRet sentenciaEjecutableConRet ';'
 162                         | sentenciaEjecutableConRet ';'

 163  bloqueSentenciaEjecutableConRet : sentenciaEjecutableConRet ';'
 164                                  | sentenciaEjecutableConRet error
 165                                  | BEGIN cuerpoEjecutableConRet END

 166  clausulaBucle : REPEAT bloqueSentenciaEjecutable WHILE '(' condicion ')'
 167                | REPEAT error WHILE '(' condicion ')'
 168                | REPEAT bloqueSentenciaEjecutable WHILE error condicion ')'
 169                | REPEAT bloqueSentenciaEjecutable WHILE '(' error ')'
 170                | REPEAT bloqueSentenciaEjecutable WHILE '(' condicion
 171                | REPEAT bloqueSentenciaEjecutable WHILE error condicion error
 172                | REPEAT error WHILE '(' error ')'
 173                | REPEAT error WHILE error condicion error
 174                | REPEAT bloqueSentenciaEjecutable error

 175  goto : GOTO etiqueta '@'
 176       | GOTO etiqueta error
 177       | GOTO error '@'
 178       | etiqueta '@'

 179  etiqueta : IDENTIFICADOR ':'
 180           | ':'

 181  mensajeSalida : OUTF '(' expresion ')'
 182                | OUTF '(' CADENA_MULTI ')'
 183                | OUTF '(' error ')'

