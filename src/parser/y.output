   0  $accept : programa $end

   1  programa : IDENTIFICADOR BEGIN cuerpo END
   2           | IDENTIFICADOR BEGIN END
   3           | IDENTIFICADOR BEGIN cuerpo
   4           | IDENTIFICADOR error cuerpo END
   5           | BEGIN cuerpo END
   6           | IDENTIFICADOR error cuerpo error

   7  cuerpo : cuerpo sentencia
   8         | sentencia

   9  sentencia : sentenciaDeclarativa
  10            | sentenciaEjecutable ';'
  11            | etiqueta
  12            | sentenciaEjecutable error
  13            | error ';'

  14  sentenciaDeclarativa : tipoDato IDENTIFICADOR ';'
  15                       | tipoDato IDENTIFICADOR ',' listaVariable ';'
  16                       | tipoDato IDENTIFICADOR ',' error ';'
  17                       | tipoDato IDENTIFICADOR ',' listaVariable error ';'
  18                       | tipoDato IDENTIFICADOR error ';'
  19                       | typedefDeclaracion ';'
  20                       | tipoDato funDeclaracion ';'

  21  typedefDeclaracion : TYPEDEF declaracionSubtipo
  22                     | TYPEDEF declaracionTriple
  23                     | error declaracionSubtipo
  24                     | error declaracionTriple
  25                     | TYPEDEF error

  26  declaracionSubtipo : IDENTIFICADOR SIMASIGNACION tipoDato '{' listaConstante '}'
  27                     | error SIMASIGNACION tipoDato '{' listaConstante '}'

  28  declaracionTriple : TRIPLE '<' tipoDato '>' IDENTIFICADOR
  29                    | TRIPLE '<' IDENTIFICADOR '>' IDENTIFICADOR
  30                    | TRIPLE '<' error '>' IDENTIFICADOR
  31                    | TRIPLE '<' tipoDato '>' error
  32                    | TRIPLE '<' IDENTIFICADOR '>' error
  33                    | TRIPLE '<' error '>' error
  34                    | TRIPLE IDENTIFICADOR '>' IDENTIFICADOR
  35                    | TRIPLE '<' IDENTIFICADOR IDENTIFICADOR
  36                    | TRIPLE IDENTIFICADOR IDENTIFICADOR
  37                    | TRIPLE tipoDato IDENTIFICADOR

  38  funDeclaracion : FUN IDENTIFICADOR '(' parametro ')' BEGIN cuerpoFuncion END
  39                 | FUN error '(' parametro ')' BEGIN cuerpoFuncion END
  40                 | FUN IDENTIFICADOR '(' parametro ',' error ')' BEGIN cuerpoFuncion END
  41                 | FUN IDENTIFICADOR '(' parametro ')' BEGIN error END

  42  tipoDato : SINGLE
  43           | LONGINT
  44           | HEXADECIMAL

  45  listaVariable : listaVariable ',' IDENTIFICADOR
  46                | listaVariable ',' error
  47                | IDENTIFICADOR

  48  listaConstante : listaConstante ',' constante
  49                 | constante

  50  constante : CONSTANTE
  51            | '-' CONSTANTE

  52  parametro : tipoDato IDENTIFICADOR
  53            | error IDENTIFICADOR
  54            | tipoDato error

  55  cuerpoFuncion : cuerpoFuncion sentenciaConRet
  56                | sentenciaConRet

  57  sentenciaConRet : sentenciaDeclarativa ';'
  58                  | sentenciaEjecutableConRet ';'
  59                  | etiqueta
  60                  | sentenciaDeclarativa
  61                  | sentenciaEjecutableConRet

  62  sentenciaRet : RET '(' expresion ')'

  63  sentenciaEjecutable : asignacion
  64                      | clausulaSeleccion
  65                      | clausulaBucle
  66                      | goto
  67                      | mensajeSalida

  68  sentenciaEjecutableConRet : asignacion
  69                            | clausulaBucle
  70                            | goto
  71                            | mensajeSalida
  72                            | sentenciaRet
  73                            | clausulaSeleccionConRet

  74  asignacion : IDENTIFICADOR SIMASIGNACION expresion
  75             | IDENTIFICADOR CADENA_MULTI SIMASIGNACION expresion

  76  expresion : operando operador operando
  77            | expresion operador operando
  78            | operando error operando error
  79            | operando operador error
  80            | error operador operando

  81  operador : '+'
  82           | '-'
  83           | '*'
  84           | '/'

  85  operando : IDENTIFICADOR
  86           | constante
  87           | invocacionFuncion
  88           | IDENTIFICADOR CADENA_MULTI
  89           | IDENTIFICADOR '1'
  90           | IDENTIFICADOR '2'
  91           | IDENTIFICADOR '3'

  92  invocacionFuncion : IDENTIFICADOR '(' expresion ')'
  93                    | IDENTIFICADOR '(' tipoDato expresion ')'
  94                    | IDENTIFICADOR '(' tipoDato '(' expresion ')' ')'
  95                    | IDENTIFICADOR '(' expresion ',' error ')'
  96                    | IDENTIFICADOR '(' error ')'
  97                    | IDENTIFICADOR '(' tipoDato expresion ',' error ')'
  98                    | IDENTIFICADOR '(' tipoDato '(' expresion ')' ',' error ')'

  99  clausulaSeleccion : IF '(' condicion ')' THEN bloqueSentenciaEjecutable END_IF
 100                    | IF '(' condicion ')' THEN bloqueSentenciaEjecutable ELSE bloqueSentenciaEjecutable END_IF
 101                    | IF '(' condicion ')' THEN bloqueSentenciaEjecutable error
 102                    | IF '(' condicion ')' THEN bloqueSentenciaEjecutable ELSE bloqueSentenciaEjecutable error
 103                    | IF '(' condicion THEN bloqueSentenciaEjecutable ELSE bloqueSentenciaEjecutable END_IF
 104                    | IF '(' condicion THEN bloqueSentenciaEjecutable END_IF
 105                    | IF condicion ')' THEN bloqueSentenciaEjecutable ELSE bloqueSentenciaEjecutable END_IF
 106                    | IF condicion ')' THEN bloqueSentenciaEjecutable END_IF
 107                    | IF condicion THEN bloqueSentenciaEjecutable ELSE bloqueSentenciaEjecutable END_IF
 108                    | IF condicion THEN bloqueSentenciaEjecutable END_IF
 109                    | IF '(' condicion ')' THEN error END_IF
 110                    | IF '(' condicion ')' THEN bloqueSentenciaEjecutable ELSE error END_IF
 111                    | IF '(' condicion ')' THEN error ELSE bloqueSentenciaEjecutable END_IF
 112                    | IF '(' condicion ')' THEN error ELSE error END_IF

 113  clausulaSeleccionConRet : IF '(' condicion ')' THEN bloqueSentenciaEjecutableConRet END_IF
 114                          | IF '(' condicion ')' THEN bloqueSentenciaEjecutableConRet ELSE bloqueSentenciaEjecutableConRet END_IF
 115                          | IF '(' condicion ')' THEN bloqueSentenciaEjecutableConRet error
 116                          | IF '(' condicion ')' THEN bloqueSentenciaEjecutableConRet ELSE bloqueSentenciaEjecutableConRet error
 117                          | IF '(' condicion THEN bloqueSentenciaEjecutableConRet ELSE bloqueSentenciaEjecutableConRet END_IF
 118                          | IF '(' condicion THEN bloqueSentenciaEjecutableConRet END_IF
 119                          | IF condicion ')' THEN bloqueSentenciaEjecutableConRet ELSE bloqueSentenciaEjecutableConRet END_IF
 120                          | IF condicion ')' THEN bloqueSentenciaEjecutableConRet END_IF
 121                          | IF condicion THEN bloqueSentenciaEjecutableConRet ELSE bloqueSentenciaEjecutableConRet END_IF
 122                          | IF condicion THEN bloqueSentenciaEjecutableConRet END_IF
 123                          | IF '(' condicion ')' THEN error END_IF
 124                          | IF '(' condicion ')' THEN bloqueSentenciaEjecutableConRet ELSE error END_IF
 125                          | IF '(' condicion ')' THEN error ELSE bloqueSentenciaEjecutableConRet END_IF
 126                          | IF '(' condicion ')' THEN error ELSE error END_IF

 127  condicion : listaExpresiones comparador listaExpresiones
 128            | listaExpresiones comparador error
 129            | error comparador listaExpresiones
 130            | listaExpresiones error listaExpresiones

 131  listaExpresiones : '(' listaExpresion ')'
 132                   | listaExpresion

 133  listaExpresion : listaExpresion ',' expresion
 134                 | expresion
 135                 | error ',' expresion
 136                 | listaExpresion ',' error

 137  comparador : '<'
 138             | '>'
 139             | '='
 140             | DISTINTO
 141             | MENOR_IGUAL
 142             | MAYOR_IGUAL

 143  cuerpoEjecutable : cuerpoEjecutable sentenciaEjecutable ';'
 144                   | sentenciaEjecutable ';'
 145                   | sentenciaEjecutable error

 146  bloqueSentenciaEjecutable : sentenciaEjecutable ';'
 147                            | sentenciaEjecutable error
 148                            | BEGIN cuerpoEjecutable END

 149  cuerpoEjecutableConRet : cuerpoEjecutableConRet sentenciaEjecutableConRet ';'
 150                         | sentenciaEjecutableConRet ';'

 151  bloqueSentenciaEjecutableConRet : sentenciaEjecutableConRet
 152                                  | BEGIN cuerpoEjecutableConRet END

 153  clausulaBucle : REPEAT bloqueSentenciaEjecutable WHILE '(' condicion ')'
 154                | REPEAT error WHILE '(' condicion ')'
 155                | REPEAT bloqueSentenciaEjecutable WHILE error condicion ')'
 156                | REPEAT bloqueSentenciaEjecutable WHILE '(' error ')'
 157                | REPEAT bloqueSentenciaEjecutable WHILE '(' condicion
 158                | REPEAT bloqueSentenciaEjecutable WHILE error condicion error
 159                | REPEAT error WHILE '(' error ')'
 160                | REPEAT error WHILE error condicion error
 161                | REPEAT bloqueSentenciaEjecutable error

 162  goto : GOTO etiqueta '@'
 163       | GOTO etiqueta error
 164       | etiqueta '@'

 165  etiqueta : IDENTIFICADOR ':'
 166           | error ':'

 167  mensajeSalida : OUTF '(' expresion ')'
 168                | OUTF '(' CADENA_MULTI ')'
 169                | OUTF '(' error ')'

