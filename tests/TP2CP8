BEGIN
    ## Formato valido
    longint fun hola (longint a) BEGIN
        x := 3;
        ret (x);
    end;

    ##Falta de nombre de parametro formal en declaracion de funcion.  
    longint fun hola (longint) BEGIN
        x := 3;
        ret (x);
    end;

    ##Falta de tipo de parametro formal en declaracion de funcion.
    longint fun hola (test) BEGIN
        x := 3;
        ret (x);
    end;

    ##Falta de funcion. ## MAL LA LINEA
    longint fun (test) BEGIN
        x := 3;
        ret (x);
    end;

    ## Formato valido
    outf(hola);

    ## Falta parametro en sentencia OUTF.       
    outf();

    ## Parametro incorrecto en sentencia OUTF. 
    outf(longint a);

    ## Formato valido
    x := hola(bien);

    ## Cantidad erronea de parametros en declaracion o invocacion de funcion.  
    x := hola();
    x := hola(hola , va);
    x := hola(hola , var, var, var, var);

end