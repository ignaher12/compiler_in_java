DIVISION
BEGIN
    longint a;
    longint b;
    longint auxlong;
    hexadecimal c;
    hexadecimal d;
    hexadecimal auxhexa;
    single e;
    single f;
    single auxsingle;
    a := 10;
    b := 100;
    auxlong := a / 10;
    outf([Valores a, b]);
    outf(a);
    outf(b);
    outf([Resultado a/10]);
    outf(auxlong);
    auxlong := a / b;
    outf([Resultado a/b]);
    outf(auxlong);
    auxlong := a / -1;
    outf([Resultado a/-1]);
    outf(auxlong);
    auxlong := a / -1000;
    outf([Resultado a/-1000]);
    outf(auxlong);
    c := 0x00000010;
    d := 0x0000000D;
    auxhexa := c / 0x0000000A;
    outf([Valores c, d]);
    outf(c);
    outf(d);
    outf([Resultado c/0x0000000A]);
    outf(auxhexa);
    auxhexa := c / d;
    outf([Resultado c/d]);
    outf(auxhexa);
    auxhexa := c / -0x00000001;
    outf([Resultado c/-0x00000001 ]);
    outf(auxhexa);
    auxhexa := -0x00000010;
    outf([Resultado -0x00000010 ]);
    outf(auxhexa);
    e := 1.10;
    f := 10.10s+10;
    auxsingle := e / 1.10;
    outf([Valores e, f]);
    outf(e);
    outf(f);
    outf([Resultado e / 1.10]);
    outf(auxsingle);
    auxsingle := e / f;
    outf([Resultado e/f]);
    outf(auxsingle);
    auxsingle := e / -1.00;
    outf([Resultado e/-1.00 ]);
    outf(auxsingle);
end;